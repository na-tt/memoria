	keywords = {Computer architecture, Microservice architectures, Autonomous Driving, Autonomous vehicles, Containerization, Containers, End-to-End Latency, Measurement, Operating systems, Real-time systems, Robot Operating System 2, Software, Software-Defined Vehicle, Standards, Virtualization},
	pages = {57--66},
	file = {PDF:/home/nat/Zotero/storage/MXXENM57/Betz et al. - 2024 - A Containerized Microservice Architecture for a ROS 2 Autonomous Driving Software An End-to-End Lat.pdf:application/pdf;Snapshot:/home/nat/Zotero/storage/IZZE23XH/10695621.html:text/html},
