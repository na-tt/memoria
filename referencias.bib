	month = may,
	year = {2024},
	keywords = {Benchmark testing, Closed box, Hardware, Interference, Pipelines, System performance, Systems architecture},
	pages = {8288--8297},
	file = {PDF:/home/nat/Zotero/storage/7V94Z88L/Mayoral-Vilches et al. - 2024 - RobotPerf An Open-Source, Vendor-Agnostic, Benchmarking Suite for Evaluating Robotics Computing Sys.pdf:application/pdf;Snapshot:/home/nat/Zotero/storage/XENIXVBA/10610841.html:text/html},
