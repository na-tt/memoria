	pages = {3692},
	file = {Full Text PDF:/home/nat/Zotero/storage/UFWVF56C/Machado et al. - 2025 - Textile Defect Detection Using Artificial Intelligence and Computer Vision—A Preliminary Deep Learni.pdf:application/pdf},
}

@article{muchtar2025,
