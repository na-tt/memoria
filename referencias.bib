  booktitle = {2024 {{IEEE}} 30th {{International Conference}} on {{Embedded}} and {{Real-Time Computing Systems}} and {{Applications}} ({{RTCSA}})},
  author = {Betz, Tobias and Wen, Long and Pan, Fengjunjie and Kaljavesi, Gemb and Zuepke, Alexander and Bastoni, Andrea and Caccamo, Marco and Knoll, Alois and Betz, Johannes},
