	keywords = {data distribution service, embedded, Embedded systems, Middleware, Peer-to-peer computing, Protocols, publish/subscribe, quality of service, Quality of service, real-time, Real-time systems, robot operating system},
	pages = {1--10},
	file = {Full Text PDF:/home/nat/Zotero/storage/N3VG2EQZ/Maruyama et al. - 2016 - Exploring the performance of ROS2.pdf:application/pdf},
}

@article{portugal2025,
