@article{macenski2023,
	title = {Impact of {ROS} 2 {Node} {Composition} in {Robotic} {Systems}},
	volume = {8},
	issn = {2377-3766},
	url = {https://ieeexplore.ieee.org/document/10132508},
	doi = {10.1109/LRA.2023.3279614},
	abstract = {The Robot Operating System 2 (ROS 2) is the second generation of ROS representing a step forward in the robotic framework. Several new types of nodes and executor models are integral to control where, how, and when information is processed in the computational graph. This letter explores and benchmarks one of these new node types - the Component node - which allows nodes to be composed manually or dynamically into processes while retaining separation of concerns in a codebase for distributed development. Composition is shown to achieve a high degree of performance optimization, particularly valuable for resource-constrained systems and sensor processing pipelines, enabling distributed tasks that would not be otherwise possible in ROS 2. In this work, we briefly introduce the significance and design of node composition, then our contribution of benchmarking is provided to analyze its impact on robotic systems. Its compelling influence on performance is shown through several experiments on the latest Long Term Support (LTS) ROS 2 distribution, Humble Hawksbill.},
	number = {7},
	urldate = {2026-09-29},
	journal = {IEEE Robotics and Automation Letters},
	author = {Macenski, Steve and Soragna, Alberto and Carroll, Michael and Ge, Zhenpeng},
	month = jul,
	year = {2023},
	keywords = {Operating systems, Benchmark testing, Engineering for robotic systems, Middleware, Optimization, Robot sensing systems, Robots, software architecture for robotic and automation, software tools for robot programming, Task analysis},
	pages = {3996--4003},
	file = {PDF:/home/nat/Zotero/storage/5LEEP78C/Macenski et al. - 2023 - Impact of ROS 2 Node Composition in Robotic Systems.pdf:application/pdf;Snapshot:/home/nat/Zotero/storage/GVW75T47/10132508.html:text/html},
}

@inproceedings{luo2025,
	title = {On the {Scalability} and {Efficiency} of {Intra}-{Process} {Communication} in {Ros} 2},
	issn = {2576-3172},
	url = {https://ieeexplore.ieee.org/document/11315062},
	doi = {10.1109/RTSS66672.2025.00014},
	abstract = {The Robot Operating System 2 (ROS 2) has become a widely adopted middleware framework for building modular and distributed robotic systems. Its intra-process communication mechanism is designed to reduce latency by avoiding serialization and memory copying, which is often treated as a negligible or constant-cost operation in both system design and performance analysis. However, this assumption oversimplifies the underlying behavior and may lead to inaccurate performance models and misleading conclusions, especially in latency-sensitive applications. In this paper, we present a comprehensive analysis of intraprocess communication in ROS 2, revealing that its performance is highly sensitive to message configuration, workload structure, and message usage strategies. We identify a scalability risk caused by misaligned communication configurations and propose a guideline to ensure efficient and predictable intra-process communication across varying execution patterns. In addition, we uncover a performance bottleneck in the default ROS 2 implementation stemming from repeated message creation. To address this, we propose a novel message pooling mechanism that reuses message objects to exploit temporal locality and eliminate redundant allocations. Our design is fully compatible with existing ROS 2 APIs and requires no modifications to application-level code. Experimental evaluations using synthetic benchmarks and real-world case studies demonstrate substantial improvements in communication latency, validating the practicality of our design.},
	urldate = {2026-09-29},
	booktitle = {2025 {IEEE} {Real}-{Time} {Systems} {Symposium} ({RTSS})},
	author = {Luo, Xiantong and Jiang, Xu and Liu, Yichen and Guan, Nan and Tang, Yue and Zhang, Shaoshuai},
	month = dec,
	year = {2025},
	note = {ISSN: 2576-3172},
	keywords = {Scalability, Operating systems, Real-time systems, Benchmark testing, Middleware, Optimization, Robots, Guidelines, Performance analysis, Resource management},
	pages = {55--67},
	file = {Full Text PDF:/home/nat/Zotero/storage/I7EHTRNJ/Luo et al. - 2025 - On the Scalability and Efficiency of Intra-Process Communication in Ros 2.pdf:application/pdf},
}

@misc{kronauer2021,
	title = {Latency {Analysis} of {ROS2} {Multi}-{Node} {Systems}},
	url = {http://arxiv.org/abs/2101.02074},
	doi = {10.48550/arXiv.2101.02074},
	abstract = {The Robot Operating System 2 (ROS2) targets distributed real-time systems and is widely used in the robotics community. Especially in these systems, latency in data processing and communication can lead to instabilities. Though being highly configurable with respect to latency, ROS2 is often used with its default settings. In this paper, we investigate the end-to-end latency of ROS2 for distributed systems with default settings and different Data Distribution Service (DDS) middlewares. In addition, we profile the ROS2 stack and point out latency bottlenecks. Our findings indicate that end-to-end latency strongly depends on the used DDS middleware. Moreover, we show that ROS2 can lead to 50\% latency overhead compared to using low-level DDS communications. Our results imply guidelines for designing distributed ROS2 architectures and indicate possibilities for reducing the ROS2 overhead.},
	urldate = {2026-09-29},
	publisher = {arXiv},
	author = {Kronauer, Tobias and Pohlmann, Joshwa and Matthe, Maximilian and Smejkal, Till and Fettweis, Gerhard},
	month = jun,
	year = {2021},
	note = {arXiv:2101.02074 [cs.RO]
version: 3},
	keywords = {Computer Science - Distributed, Parallel, and Cluster Computing, Computer Science - Multiagent Systems, Computer Science - Performance, Computer Science - Robotics, Computer Science - Software Engineering},
	file = {Preprint PDF:/home/nat/Zotero/storage/UBUKLNBH/Kronauer et al. - 2021 - Latency Analysis of ROS2 Multi-Node Systems.pdf:application/pdf;Snapshot:/home/nat/Zotero/storage/QXHRSE82/2101.html:text/html},
}

@inproceedings{kamiya2025,
	title = {Latency {Analysis} in {Internal} {Layers} of {Shared} {Memory} {Communication} in {ROS2}},
	url = {https://ieeexplore.ieee.org/document/11423038},
	doi = {10.1109/RAAI67517.2025.11423038},
	abstract = {Inter-process communication is essential for autonomous mobile robots that process large amounts of sensor data at high frequencies. Robot Operating System 2 (ROS2) provides various communication methods, including shared memory communication using Data Distribution Service (DDS). However, detailed analysis of latency in the internal layers has not been sufficiently conducted. In this study, we investigated the latency of internal layers in shared memory communication using iceoryx. By modifying RMW (ROS MiddleWare) and adding timestamp recording at the boundaries between ROS2 and DDS, the sources of the overall latency were separated into ROS2 and DDS components. Latency was evaluated for data sizes from 1 KB to 10 MB. The results showed that the overall latency was reduced to less than half compared to socket communication. Most of the difference was attributed to DDS. The parts performing input and output from DDS were significantly reduced through zero-copy implementation. Based on these findings, we discussed improvement strategies and the methodology for selecting measurement positions.},
	urldate = {2026-09-29},
	booktitle = {2025 5th {International} {Conference} on {Robotics}, {Automation}, and {Artificial} {Intelligence} ({RAAI})},
	author = {Kamiya, Sho and Adachi, Miho and Xue, JunFeng and Miyamoto, Ryusuke},
	month = dec,
	year = {2025},
	keywords = {Operating systems, Middleware, Robot sensing systems, Communication Latency, Hands, High frequency, Mobile robots, Performance evaluation, Performance Measurement, Position measurement, Recording, ROS2, Sockets},
	pages = {92--96},
	file = {Full Text PDF:/home/nat/Zotero/storage/FLSBL32L/Kamiya et al. - 2025 - Latency Analysis in Internal Layers of Shared Memory Communication in ROS2.pdf:application/pdf},
}

