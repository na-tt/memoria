# Ruta de un mensaje entre dos nodos de ROS 2 en procesos separados.
#
# Hay un búfer a cada lado, no solo en el suscriptor. Según la especificación
# RTPS (OMG DDSI-RTPS 2.5, §8.2.1 y §8.2.2), cada operación de escritura agrega
# un CacheChange a la HistoryCache del RTPS Writer (búfer de salida) y el Writer
# transfiere ese cambio a la HistoryCache de todos los RTPS Readers emparejados
# (búfer de entrada). Esas dos historias las mantiene el middleware, y su tamaño
# y retención los fija la QoS (history, depth, reliability, durability), no el
# código del nodo; por eso se dibujan dentro de la capa DDS y no como colas de
# la aplicación.
#
# El diagrama distingue por color las etapas que pertenecen a la capa
# rmw/DDS (azul) de las que pertenecen al código del nodo (gris azulado), y
# separa el camino de los datos (línea continua) del aviso de disponibilidad
# que DDS entrega a la biblioteca cliente (línea discontinua), citado en la
# literatura como *notification delay*.

direction: down

# Posiciones absolutas: se fijan con `top`/`left`, que solo TALA respeta. Así el
# transporte queda entre los dos procesos y el resultado se reproduce igual sin
# pasar banderas al compilar.
vars: {
  d2-config: {
    layout-engine: tala
  }
}

classes: {
  etapa: {
    shape: rectangle
    style: {
      fill: "#e8eef7"
      stroke: "#2f4b7c"
      stroke-width: 2
      border-radius: 8
      font-size: 24
      bold: true
    }
  }
  dds: {
    shape: rectangle
    style: {
      fill: "#cfdcef"
      stroke: "#2f4b7c"
      stroke-width: 2
      border-radius: 8
      font-size: 24
      bold: true
    }
  }
  flujo: {
    style: {
      stroke: "#2f4b7c"
      stroke-width: 2
      font-size: 18
    }
  }
  aviso: {
    style: {
      stroke: "#2f4b7c"
      stroke-width: 2
      stroke-dash: 4
      font-size: 20
    }
  }
  proceso: {
    style: {
      fill: "#f4f7fb"
      stroke: "#2f4b7c"
      stroke-width: 2
      stroke-dash: 4
      border-radius: 12
      font-size: 22
      bold: true
    }
  }
}

publicador: "Proceso publicador" {
  top: 20
  left: 20
  class: proceso
  mensaje: "Mensaje ROS\n(sensor_msgs/Image)" { class: etapa }
  serializacion: "Serialización\na muestra DDS" { class: etapa }
  whc: "DataWriter\n(historia de\nescritura,\nbúfer de salida)" { class: dds }

  mensaje -> serializacion: { class: flujo }
  serializacion -> whc: { class: flujo }
}

transporte: "Transporte\n(sockets o\nmemoria compartida)" {
  class: etapa
  top: 300
  left: 780
}

suscriptor: "Proceso suscriptor" {
  top: 540
  left: 20
  class: proceso
  rhc: "DataReader\n(historia de\nlectura,\nbúfer de entrada)" { class: dds }
  deserializacion: "Toma y\ndeserialización\n(mensaje ROS)" { class: etapa }
  ejecutor: "Ejecutor → callback" { class: etapa }

  rhc -> deserializacion: { class: flujo }
  deserializacion -> ejecutor: { class: flujo }
  rhc -> ejecutor: {
    class: aviso
    label: "aviso de disponibilidad\n(conjunto de espera)"
  }
}

publicador.whc -> transporte: { class: flujo }
transporte -> suscriptor.rhc: { class: flujo }
